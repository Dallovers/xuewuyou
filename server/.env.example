PORT=3000
HOST=127.0.0.1
# Node 22.12+; data defaults to server/data and survives restarts.
# Optional: DATA_DIR=D:/xuewuyou-data
JWT_SECRET=
# Neon pooled connection string; keep blank for local JSON mode.
# Database mode requires a fixed JWT_SECRET. Never put this URL in frontend JS.
DATABASE_URL=
FRONTEND_ORIGIN=https://dallovers.github.io
# Optional absolute Python path; default is services/learning/.venv/Scripts/python.exe
LEARNING_PYTHON=

# AI is optional. FSRS and plain-text parsing work without a model key.
AI_PROVIDER=zhipu
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# RAGFlow: configure an Embedding model and create an API key in its dashboard.
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=

# Self-hosted MinerU 4.x V1 API (basic tier for local parsing).
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_TIER=basic
